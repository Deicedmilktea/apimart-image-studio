# Copy to .env.local and fill in the providers you want to use.

# APIMart
# Get your key at https://apimart.ai (API Key management page).
APIMART_API_KEY=replace_with_your_apimart_api_key
# APIMART_BASE_URL=https://api.apimart.ai/v1

# Local OpenAI-compatible imagegen
# These values are injected into the child process as OPENAI_BASE_URL / OPENAI_API_KEY.
# Before using this provider in a fresh environment, run: `uv sync`
# LOCAL_IMAGEGEN_BASE_URL=https://your-openai-compatible-endpoint.example.com/v1
# LOCAL_IMAGEGEN_API_KEY=replace_with_your_local_imagegen_api_key

# Optional override for the official imagegen CLI script.
# OFFICIAL_IMAGEGEN_PATH=/Users/yourname/.codex/skills/.system/imagegen/scripts/image_gen.py

# Directory where generated images are auto-saved on the server.
# Relative paths resolve against the project root.
# IMAGE_STUDIO_OUTPUT_DIR=generated

# Backward-compatible legacy output dir env:
# APIMART_OUTPUT_DIR=generated
